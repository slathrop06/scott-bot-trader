# Copy to .env and fill in. Never commit .env.

# Alpaca — get keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Anthropic — get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Finnhub — get a free API key at https://finnhub.io
FINNHUB_API_KEY=...

# "paper" or "live". Live mode requires explicit code changes — paper-only for now.
TRADING_MODE=paper
